extends RefCounted

## Canonical Yellow Wind insertion, expedition routing, mainline gates and legacy-save migration.
static func run_all() -> Dictionary:
	var ids: Array[String] = []
	for chapter in SharedJourneyManager.get_all_chapters():
		ids.append(str(chapter.get("id", "")))
	var four_person_index := ids.find("SHARED-06-FOUR-PERSON-JOURNEY")
	var yellow_index := ids.find("SHARED-06A-YELLOW-WIND")
	var sands_index := ids.find("SHARED-07-FLOWING-SANDS")
	assert(four_person_index >= 0 and yellow_index == four_person_index + 1, "Yellow Wind must immediately follow the four-person road")
	assert(sands_index == yellow_index + 1, "Flowing Sands must immediately follow the Yellow Wind trial")
	var definition := SharedJourneyManager.get_definition("SHARED-06A-YELLOW-WIND")
	assert(definition.get_timeline() == 145, "Yellow Wind completion must land at T145")
	assert(definition.get_encounter_id() == "YELLOW_WIND_KING", "the chapter must use the mainline King encounter")
	assert(definition.get_legacy_boss_target_id() == "YELLOW_WIND_KING", "legacy compatibility uses the mainline target ID")
	var destination := ChapterRuntime.destination(definition)
	assert(str(destination.get("kind", "")).to_lower() == "expedition", "Journey routes into the expedition")
	assert(str(destination.get("location_id", "")) == "BLACK_WIND_NORTH_PATH", "expedition starts at Black Wind North Path")
	var manager := NarrativeManager.new()
	assert(manager.start_new_game("WUKONG"))
	assert(manager.encounter_character("TANG", []))
	assert(manager.encounter_character("WUKONG", []))
	assert(manager.encounter_character("LONGMA", []))
	assert(manager.encounter_character("BAJIE", []))
	manager.state.record_milestone("WUKONG_RECRUITED", 100)
	manager.state.record_milestone("BAI_LONGMA_RECRUITED", 110)
	manager.state.record_milestone("ZHU_BAJIE_RECRUITED", 130)
	manager.state.current_global_timeline = 130
	manager.state.completed_shared_chapters = ["SHARED-01-FIVE-ELEMENTS","SHARED-02-EARLY-PILGRIMAGE","SHARED-03-EAGLE-SORROW","SHARED-04-EARLY-DEMON-TALES","SHARED-05-GAOJIAZHUANG"]
	manager.state.set_current_shared_chapter("SHARED-06-FOUR-PERSON-JOURNEY")
	assert(SharedJourneyManager.complete("SHARED-06-FOUR-PERSON-JOURNEY", manager, false))
	assert(manager.state.current_shared_chapter == "SHARED-06A-YELLOW-WIND")
	assert(manager.state.current_global_timeline == 140)
	assert(SharedJourneyManager.can_enter("SHARED-06A-YELLOW-WIND", manager.state))
	var ridge := YellowWindRidgeManager.new()
	manager.state.add_world_node_visit("GAOJIAZHUANG")
	assert(not ridge.is_available(manager))
	var world := WorldMapManager.new()
	assert(world.can_visit(manager, "BLACK_WIND_NORTH_PATH"))
	assert(world.visit(manager, "BLACK_WIND_NORTH_PATH"))
	assert(ridge.is_available(manager))
	var before := manager.serialize().duplicate(true)
	assert(not SharedJourneyManager.complete("SHARED-06A-YELLOW-WIND", manager, false))
	assert(manager.serialize() == before, "premature chapter completion must not mutate state")
	var legacy := NarrativeManager.new()
	assert(legacy.start_new_game("WUKONG"))
	legacy.encounter_character("TANG", [])
	legacy.encounter_character("WUKONG", [])
	legacy.encounter_character("LONGMA", [])
	legacy.encounter_character("BAJIE", [])
	legacy.state.record_milestone("WUKONG_RECRUITED", 100)
	legacy.state.record_milestone("BAI_LONGMA_RECRUITED", 110)
	legacy.state.record_milestone("ZHU_BAJIE_RECRUITED", 130)
	legacy.state.current_global_timeline = 140
	legacy.state.completed_shared_chapters = ["SHARED-01-FIVE-ELEMENTS","SHARED-02-EARLY-PILGRIMAGE","SHARED-03-EAGLE-SORROW","SHARED-04-EARLY-DEMON-TALES","SHARED-05-GAOJIAZHUANG","SHARED-06-FOUR-PERSON-JOURNEY"]
	legacy.state.set_current_shared_chapter("SHARED-06A-YELLOW-WIND")
	legacy.state.journey_log["defeated_targets"].append("BOUNTY_YELLOW_FANG")
	legacy.state.journey_log["defeated_targets"].append("YELLOW_WIND_KING")
	legacy.state.set_inventory({"currencies":{"COIN":77},"items":{"DEMON_FANG":1}})
	var old_inventory := legacy.state.get_inventory().duplicate(true)
	assert(SharedJourneyManager.complete("SHARED-06A-YELLOW-WIND", legacy, false))
	assert(legacy.state.current_shared_chapter == "SHARED-07-FLOWING-SANDS")
	assert(legacy.state.current_global_timeline == 145)
	assert("SHARED_BATTLE_YELLOW_WIND_KING" in legacy.state.completed_milestones)
	assert(legacy.state.get_inventory() == old_inventory)
	assert("BOUNTY_YELLOW_FANG" in legacy.state.get_journey_log().get("defeated_targets", []))
	return {"passed":true,"shared_order":ids,"legacy_migration_without_duplicate_rewards":true}
