{
  "schema_version": 1,
  "description": "Origin Route EventSequences separated from the shared production sequence catalog.",
  "sequences": [
    {
      "id": "TANG-01-SEQUENCE",
      "chapter_id": "TANG-01",
      "namespace": "ORIGIN",
      "start": "birth",
      "nodes": [
        {"id":"birth","type":"dialogue","speaker":"旁白","text":"少年玄奘在寺院里第一次接触到经卷。比起答案，他更早学会了追问答案的意义。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-02-SEQUENCE",
      "chapter_id": "TANG-02",
      "namespace": "ORIGIN",
      "start": "vow",
      "nodes": [
        {"id":"vow","type":"dialogue","speaker":"玄奘","text":"出家不是离开众人，而是从此把自己的选择当成一生的责任。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-03-SEQUENCE",
      "chapter_id": "TANG-03",
      "namespace": "ORIGIN",
      "start": "teacher",
      "nodes": [
        {"id":"teacher","type":"dialogue","speaker":"玄奘","text":"声名越来越大，我反而更常看见教义与现实之间的裂缝。若经文不能落到众生身上，背得再熟也只是纸上的道理。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-04-SEQUENCE",
      "chapter_id": "TANG-04",
      "namespace": "ORIGIN",
      "start": "edict",
      "nodes": [
        {"id":"edict","type":"dialogue","speaker":"玄奘","text":"长安的诏命到了。西行从此不只是我一个人的修行，也成了必须面对的众生之事。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"TANG-04","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-05-SEQUENCE",
      "chapter_id": "TANG-05",
      "namespace": "ORIGIN",
      "start": "departure",
      "nodes": [
        {"id":"departure","type":"dialogue","speaker":"玄奘","text":"城门就在身后。真正踏上路以后，取经不再是一句愿望，而是每一天都要重新确认的选择。","next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"旁白","text":"他回望长安最后一眼，然后继续向西。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-06-SEQUENCE",
      "chapter_id": "TANG-06",
      "namespace": "ORIGIN",
      "start": "ridge",
      "nodes": [
        {"id":"ridge","type":"dialogue","speaker":"玄奘","text":"双叉岭的风里尽是妖气。若连眼前的人都护不住，又谈什么遥远的真经？","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"TANG_ORIGIN_DOUBLE_RIDGE","source_chapter_id":"TANG-06","source_route_id":"TANG_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"玄奘","text":"我明白了。慈悲不是不畏惧，而是明知会受伤，也愿意护住别人。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-07-SEQUENCE",
      "chapter_id": "TANG-07",
      "namespace": "ORIGIN",
      "start": "night",
      "nodes": [
        {"id":"night","type":"dialogue","speaker":"玄奘","text":"鹰愁涧就在前方。河声越近，孤身西行的危险也越真实。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"TANG-07","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-08-SEQUENCE",
      "chapter_id": "TANG-08",
      "namespace": "ORIGIN",
      "start": "mountain",
      "nodes": [
        {"id":"mountain","type":"dialogue","speaker":"玄奘","text":"五行山下有人在呼喊。或许前方的人与你想象不同，但取经路上，总要先学会面对未知。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"TANG_ORIGIN_FIVE_ELEMENTS","source_chapter_id":"TANG-08","source_route_id":"TANG_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"玄奘","text":"山下这个人，也许会成为同行者。既然命运让我们相遇，我愿意先听听他的故事。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-01-SEQUENCE",
      "chapter_id": "LONGMA-01",
      "namespace": "ORIGIN",
      "start": "palace",
      "nodes": [
        {"id":"palace","type":"dialogue","speaker":"旁白","text":"西海龙宫深处，龙族少年从小被教导记住血脉与职责。可越是懂得自己是谁，越会想问自己要成为什么。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-02-SEQUENCE",
      "chapter_id": "LONGMA-02",
      "namespace": "ORIGIN",
      "start": "trial",
      "nodes": [
        {"id":"trial","type":"dialogue","speaker":"白龙","text":"罪责落到身上之后，龙族血脉不再像荣耀，更像一块不能逃开的石头。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"LONGMA-02","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"LONGMA_ORIGIN_SEA_CLIFF","source_chapter_id":"LONGMA-02","source_route_id":"LONGMA_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"白龙","text":"至少这一次，我没有把责任推给别人。真正的担当，或许就是从这里开始。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-03-SEQUENCE",
      "chapter_id": "LONGMA-03",
      "namespace": "ORIGIN",
      "start": "ravine",
      "nodes": [
        {"id":"ravine","type":"dialogue","speaker":"旁白","text":"鹰愁涧的水声把旧日的龙宫隔在身后。陌生河谷里，一个取经人的脚步正在靠近新的命运。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-04-SEQUENCE",
      "chapter_id": "LONGMA-04",
      "namespace": "ORIGIN",
      "start": "oath",
      "nodes": [
        {"id":"oath","type":"dialogue","speaker":"白龙","text":"护送如果只是服刑，我永远只是被驱赶的坐骑。可若是我主动守护一个人，这条路就会有另一种意义。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"LONGMA-04","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-05-SEQUENCE",
      "chapter_id": "LONGMA-05",
      "namespace": "ORIGIN",
      "start": "approach",
      "nodes": [
        {"id":"approach","type":"dialogue","speaker":"白龙","text":"取经人的气息已经进了河谷。若我要守护这条路，就不能等别人来告诉我该怎么做。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"LONGMA_ORIGIN_YINGCHOU","source_chapter_id":"LONGMA-05","source_route_id":"LONGMA_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"白龙","text":"今日我守住的不是一条河，而是一个还没来得及认识我的人。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-06-SEQUENCE",
      "chapter_id": "LONGMA-06",
      "namespace": "ORIGIN",
      "start": "change",
      "nodes": [
        {"id":"change","type":"dialogue","speaker":"白龙","text":"龙身留在过去，白马踏上西行路。身份可以改变，真正愿意承担的使命却要一直带在身上。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-01-SEQUENCE",
      "chapter_id": "BAJIE-01",
      "namespace": "ORIGIN",
      "start": "heaven",
      "nodes": [
        {"id":"heaven","type":"dialogue","speaker":"旁白","text":"天河水府的号令如潮。天蓬元帅统领水军，威风与掌声都来得太容易，也让他渐渐忘了职责背后的重量。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-02-SEQUENCE",
      "chapter_id": "BAJIE-02",
      "namespace": "ORIGIN",
      "start": "banquet",
      "nodes": [
        {"id":"banquet","type":"dialogue","speaker":"猪八戒","text":"蟠桃宴上的热闹让人忘了规矩。可若连自己都管不住，又凭什么说掌得住天河水军？","next":"choice"},
        {"id":"choice","type":"choice","event_id":"BAJIE-02","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-03-SEQUENCE",
      "chapter_id": "BAJIE-03",
      "namespace": "ORIGIN",
      "start": "fall",
      "nodes": [
        {"id":"fall","type":"dialogue","speaker":"旁白","text":"天河旧职一朝褪去。失去元帅名号之后，八戒第一次只能用一个普通人的眼光重新看待自己的得失。","next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"猪八戒","text":"原来没了官印，肚子还是会饿，路还是得自己走。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-04-SEQUENCE",
      "chapter_id": "BAJIE-04",
      "namespace": "ORIGIN",
      "start": "mortal",
      "nodes": [
        {"id":"mortal","type":"dialogue","speaker":"旁白","text":"凡间的烟火比天庭更近。旧日记忆没有消失，新的欲望却也随肉身一同生长。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-05-SEQUENCE",
      "chapter_id": "BAJIE-05",
      "namespace": "ORIGIN",
      "start": "gao",
      "nodes": [
        {"id":"gao","type":"dialogue","speaker":"旁白","text":"高老庄给了八戒一个看似安稳的归宿。可他越想留下，越害怕妖身迟早会把这份安稳撕碎。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-06-SEQUENCE",
      "chapter_id": "BAJIE-06",
      "namespace": "ORIGIN",
      "start": "choice",
      "nodes": [
        {"id":"choice","type":"choice","event_id":"BAJIE-06","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"BAJIE_ORIGIN_GAO_WILD","source_chapter_id":"BAJIE-06","source_route_id":"BAJIE_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"猪八戒","text":"家不是只拿来躲风的地方。真要留下，就得肯替身边的人扛一次。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-07-SEQUENCE",
      "chapter_id": "BAJIE-07",
      "namespace": "ORIGIN",
      "start": "reveal",
      "nodes": [
        {"id":"reveal","type":"dialogue","speaker":"旁白","text":"妖身终于无法再藏。别人眼中的猪妖，与八戒心里那个还想过安稳日子的人，第一次正面撞在一起。","next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"猪八戒","text":"笑我也好，怕我也罢，至少这回我不再装作自己什么都没做。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-08-SEQUENCE",
      "chapter_id": "BAJIE-08",
      "namespace": "ORIGIN",
      "start": "duel",
      "nodes": [
        {"id":"duel","type":"dialogue","speaker":"孙悟空","text":"猪八戒，躲在高老庄不是一辈子的法子。你若真有本事，就把该面对的都面对了。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"BAJIE_ORIGIN_WUKONG_DUEL","source_chapter_id":"BAJIE-08","source_route_id":"BAJIE_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"猪八戒","text":"猴哥，你赢了这一场，也逼得我终于没法再躲。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "BAJIE-09-SEQUENCE",
      "chapter_id": "BAJIE-09",
      "namespace": "ORIGIN",
      "start": "departure",
      "nodes": [
        {"id":"departure","type":"dialogue","speaker":"猪八戒","text":"高老庄的日子放不下，也不能再回头。若西行真能让我学会负责，那就走这一趟。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-01-SEQUENCE",
      "chapter_id": "WUJING-01",
      "namespace": "ORIGIN",
      "start": "guard",
      "nodes": [
        {"id":"guard","type":"dialogue","speaker":"旁白","text":"天界仪仗一日复一日地沿着旧轨道前行。卷帘大将守着秩序，却很少问自己为什么必须守到最后。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-02-SEQUENCE",
      "chapter_id": "WUJING-02",
      "namespace": "ORIGIN",
      "start": "broken",
      "nodes": [
        {"id":"broken","type":"dialogue","speaker":"沙僧","text":"琉璃盏碎在脚边的一刻，我才发现所谓秩序也会因为一次失手突然把一个人推到最底下。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"WUJING-02","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-03-SEQUENCE",
      "chapter_id": "WUJING-03",
      "namespace": "ORIGIN",
      "start": "sands",
      "nodes": [
        {"id":"sands","type":"dialogue","speaker":"沙僧","text":"流沙河没有尽头。妖身、河水和惩罚缠在一起，我只能先学会在这里活下来。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"WUJING_ORIGIN_FLOWING_SANDS","source_chapter_id":"WUJING-03","source_route_id":"WUJING_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"沙僧","text":"原来活下来并不等于赎清罪。可至少今天，我没有再任由河水替我决定命运。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-04-SEQUENCE",
      "chapter_id": "WUJING-04",
      "namespace": "ORIGIN",
      "start": "endless",
      "nodes": [
        {"id":"endless","type":"dialogue","speaker":"旁白","text":"漫长岁月把惩罚变成日常。越是没有尽头，越逼人去问：我究竟是在赎罪，还是只是在等待别人原谅？","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-05-SEQUENCE",
      "chapter_id": "WUJING-05",
      "namespace": "ORIGIN",
      "start": "traveler",
      "nodes": [
        {"id":"traveler","type":"dialogue","speaker":"沙僧","text":"一次又一次有人渡河，我也一次又一次出手阻拦。可最近我开始发现，真正让我疲惫的不是饥饿，而是不想再继续这样活下去。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-06-SEQUENCE",
      "chapter_id": "WUJING-06",
      "namespace": "ORIGIN",
      "start": "crossing",
      "nodes": [
        {"id":"crossing","type":"dialogue","speaker":"观音","text":"救赎不是替你抹掉过去，而是给你一次重新证明自己能为别人承担风险的机会。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"WUJING-06","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-07-SEQUENCE",
      "chapter_id": "WUJING-07",
      "namespace": "ORIGIN",
      "start": "trial",
      "nodes": [
        {"id":"trial","type":"dialogue","speaker":"沙僧","text":"机会就在眼前，可我已经没有资格只为自己出手。若想走出去，就得先证明自己愿意替别人挡下这一击。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"WUJING_ORIGIN_BODHISATTVA","source_chapter_id":"WUJING-07","source_route_id":"WUJING_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"沙僧","text":"这一次，我护住的不是自己的命，而是一条陌生人的渡河路。也许这才是重新做人真正的开始。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUJING-08-SEQUENCE",
      "chapter_id": "WUJING-08",
      "namespace": "ORIGIN",
      "start": "refuge",
      "nodes": [
        {"id":"refuge","type":"dialogue","speaker":"沙僧","text":"我不会忘记流沙河，也不会假装过去从没发生。若取经路允许我继续背着这些过去往前走，我愿意跟上。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    }
  ]
}
