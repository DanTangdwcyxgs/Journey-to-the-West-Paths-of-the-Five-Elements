{
  "schema_version": 1,
  "description": "Origin Route EventSequences separated from the shared production sequence catalog.",
  "sequences": [
    {
      "id": "TANG-01-SEQUENCE",
      "chapter_id": "TANG-01",
      "namespace": "ORIGIN",
      "start": "birth",
      "nodes": [
        {"id":"birth","type":"dialogue","speaker":"旁白","text":"少年玄奘在寺院里第一次接触到经卷。比起答案，他更早学会了追问答案的意义。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-02-SEQUENCE",
      "chapter_id": "TANG-02",
      "namespace": "ORIGIN",
      "start": "vow",
      "nodes": [
        {"id":"vow","type":"dialogue","speaker":"玄奘","text":"出家不是离开众人，而是从此把自己的选择当成一生的责任。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-03-SEQUENCE",
      "chapter_id": "TANG-03",
      "namespace": "ORIGIN",
      "start": "teacher",
      "nodes": [
        {"id":"teacher","type":"dialogue","speaker":"玄奘","text":"声名越来越大，我反而更常看见教义与现实之间的裂缝。若经文不能落到众生身上，背得再熟也只是纸上的道理。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-04-SEQUENCE",
      "chapter_id": "TANG-04",
      "namespace": "ORIGIN",
      "start": "edict",
      "nodes": [
        {"id":"edict","type":"dialogue","speaker":"玄奘","text":"长安的诏命到了。西行从此不只是我一个人的修行，也成了必须面对的众生之事。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"TANG-04","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-05-SEQUENCE",
      "chapter_id": "TANG-05",
      "namespace": "ORIGIN",
      "start": "departure",
      "nodes": [
        {"id":"departure","type":"dialogue","speaker":"玄奘","text":"城门就在身后。真正踏上路以后，取经不再是一句愿望，而是每一天都要重新确认的选择。","next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"旁白","text":"他回望长安最后一眼，然后继续向西。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-06-SEQUENCE",
      "chapter_id": "TANG-06",
      "namespace": "ORIGIN",
      "start": "ridge",
      "nodes": [
        {"id":"ridge","type":"dialogue","speaker":"玄奘","text":"双叉岭的风里尽是妖气。若连眼前的人都护不住，又谈什么遥远的真经？","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"TANG_ORIGIN_DOUBLE_RIDGE","source_chapter_id":"TANG-06","source_route_id":"TANG_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"玄奘","text":"我明白了。慈悲不是不畏惧，而是明知会受伤，也愿意护住别人。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-07-SEQUENCE",
      "chapter_id": "TANG-07",
      "namespace": "ORIGIN",
      "start": "night",
      "nodes": [
        {"id":"night","type":"dialogue","speaker":"玄奘","text":"鹰愁涧就在前方。河声越近，孤身西行的危险也越真实。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"TANG-07","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "TANG-08-SEQUENCE",
      "chapter_id": "TANG-08",
      "namespace": "ORIGIN",
      "start": "mountain",
      "nodes": [
        {"id":"mountain","type":"dialogue","speaker":"玄奘","text":"五行山下有人在呼喊。或许前方的人与你想象不同，但取经路上，总要先学会面对未知。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"TANG_ORIGIN_FIVE_ELEMENTS","source_chapter_id":"TANG-08","source_route_id":"TANG_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"玄奘","text":"山下这个人，也许会成为同行者。既然命运让我们相遇，我愿意先听听他的故事。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-01-SEQUENCE",
      "chapter_id": "LONGMA-01",
      "namespace": "ORIGIN",
      "start": "palace",
      "nodes": [
        {"id":"palace","type":"dialogue","speaker":"旁白","text":"西海龙宫深处，龙族少年从小被教导记住血脉与职责。可越是懂得自己是谁，越会想问自己要成为什么。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-02-SEQUENCE",
      "chapter_id": "LONGMA-02",
      "namespace": "ORIGIN",
      "start": "trial",
      "nodes": [
        {"id":"trial","type":"dialogue","speaker":"白龙","text":"罪责落到身上之后，龙族血脉不再像荣耀，更像一块不能逃开的石头。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"LONGMA-02","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"LONGMA_ORIGIN_SEA_CLIFF","source_chapter_id":"LONGMA-02","source_route_id":"LONGMA_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"白龙","text":"至少这一次，我没有把责任推给别人。真正的担当，或许就是从这里开始。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-03-SEQUENCE",
      "chapter_id": "LONGMA-03",
      "namespace": "ORIGIN",
      "start": "ravine",
      "nodes": [
        {"id":"ravine","type":"dialogue","speaker":"旁白","text":"鹰愁涧的水声把旧日的龙宫隔在身后。陌生河谷里，一个取经人的脚步正在靠近新的命运。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-04-SEQUENCE",
      "chapter_id": "LONGMA-04",
      "namespace": "ORIGIN",
      "start": "oath",
      "nodes": [
        {"id":"oath","type":"dialogue","speaker":"白龙","text":"护送如果只是服刑，我永远只是被驱赶的坐骑。可若是我主动守护一个人，这条路就会有另一种意义。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"LONGMA-04","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-05-SEQUENCE",
      "chapter_id": "LONGMA-05",
      "namespace": "ORIGIN",
      "start": "approach",
      "nodes": [
        {"id":"approach","type":"dialogue","speaker":"白龙","text":"取经人的气息已经进了河谷。若我要守护这条路，就不能等别人来告诉我该怎么做。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"LONGMA_ORIGIN_YINGCHOU","source_chapter_id":"LONGMA-05","source_route_id":"LONGMA_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"白龙","text":"今日我守住的不是一条河，而是一个还没来得及认识我的人。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "LONGMA-06-SEQUENCE",
      "chapter_id": "LONGMA-06",
      "namespace": "ORIGIN",
      "start": "change",
      "nodes": [
        {"id":"change","type":"dialogue","speaker":"白龙","text":"龙身留在过去，白马踏上西行路。身份可以改变，真正愿意承担的使命却要一直带在身上。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    }
  ]
}
