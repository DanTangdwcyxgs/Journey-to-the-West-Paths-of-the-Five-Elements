{
  "schema_version": 1,
  "sequences": [
    {
      "id": "SHARED-03-EAGLE-SORROW-SEQUENCE",
      "chapter_id": "SHARED-03-EAGLE-SORROW",
      "namespace": "SHARED",
      "start": "arrival",
      "nodes": [
        {"id":"arrival","type":"dialogue","speaker":"玄奘","text":"鹰愁涧就在前面。此处山水凶险，诸位且不可大意。","next":"encounter_choice"},
        {"id":"encounter_choice","type":"choice","event_id":"LONGMA_ENCOUNTER","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"shared","encounter_id":"SHARED_EAGLE_SORROW","source_chapter_id":"SHARED-03-EAGLE-SORROW","source_route_id":"SHARED_JOURNEY","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"玄奘","text":"因缘既已相逢，便同行吧。往后的路，还要彼此照应。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-04-EARLY-DEMON-TALES-SEQUENCE",
      "chapter_id": "SHARED-04-EARLY-DEMON-TALES",
      "namespace": "SHARED",
      "start": "departure",
      "nodes": [
        {"id":"departure","type":"dialogue","speaker":"玄奘","text":"黑风山的妖气已经逼近。我们先沿北道探看一番，再决定是否继续赶路。","next":"move_to_north_path"},
        {"id":"move_to_north_path","type":"move","map_id":"WORLD_MAP","marker_id":"BLACK_WIND_NORTH_PATH","next":"warning"},
        {"id":"warning","type":"dialogue","speaker":"孙悟空","text":"俺老孙闻到的妖气就在前头。师父，你们跟紧些，莫叫小妖钻了空子。","next":"pause"},
        {"id":"pause","type":"wait","seconds":0.3,"next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"玄奘","text":"先不急着深入。记下此处妖踪，我们向前一步，也为后面的路留一步退处。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-05-GAOJIAZHUANG-SEQUENCE",
      "chapter_id": "SHARED-05-GAOJIAZHUANG",
      "namespace": "SHARED",
      "start": "arrival",
      "nodes": [
        {"id":"arrival","type":"dialogue","speaker":"玄奘","text":"前方就是高老庄。庄中妖患未平，看来这一路又有一桩因果要了结。","next":"encounter_choice"},
        {"id":"encounter_choice","type":"choice","event_id":"BAJIE_ENCOUNTER","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"shared","encounter_id":"SHARED_GAOJIAZHUANG","source_chapter_id":"SHARED-05-GAOJIAZHUANG","source_route_id":"SHARED_JOURNEY","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"孙悟空","text":"好个天蓬，嘴硬归嘴硬，本事倒没丢。师父，这一路若多个人帮忙，未必是坏事。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-06-FOUR-PERSON-JOURNEY-SEQUENCE",
      "chapter_id": "SHARED-06-FOUR-PERSON-JOURNEY",
      "namespace": "SHARED",
      "start": "depart",
      "nodes": [
        {"id":"depart","type":"dialogue","speaker":"玄奘","text":"高老庄之后，四人同行的路比从前热闹了许多。不同的性情，也开始慢慢磨成同一个方向。","next":"observe"},
        {"id":"observe","type":"wait","seconds":0.4,"next":"resolve"},
        {"id":"resolve","type":"dialogue","speaker":"猪八戒","text":"俺也去取经就是了。先说好，路上若有好吃的，可别全叫猴哥一个人抢了。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-07-FLOWING-SANDS-SEQUENCE",
      "chapter_id": "SHARED-07-FLOWING-SANDS",
      "namespace": "SHARED",
      "start": "river",
      "nodes": [
        {"id":"river","type":"dialogue","speaker":"玄奘","text":"流沙河水势凶险。若河中之人真在等一个能够理解他的人，我们也不该只以妖怪二字定他的生死。","next":"encounter_choice"},
        {"id":"encounter_choice","type":"choice","event_id":"WUJING_ENCOUNTER","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"shared","encounter_id":"SHARED_FLOWING_SANDS","source_chapter_id":"SHARED-07-FLOWING-SANDS","source_route_id":"SHARED_JOURNEY","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"沙悟净","text":"俺在这河中守了太久。今日既有人愿意带我走，我便用余生护住这条西行路。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-08-PARTY-FULL-SEQUENCE",
      "chapter_id": "SHARED-08-PARTY-FULL",
      "namespace": "SHARED",
      "start": "gather",
      "nodes": [
        {"id":"gather","type":"dialogue","speaker":"玄奘","text":"从今日起，我们不再只是各自背负过去的人。五个人，要走同一条取经路。","next":"party_choice"},
        {"id":"party_choice","type":"choice","event_id":"PARTY_FULL","next":"oath"},
        {"id":"oath","type":"dialogue","speaker":"孙悟空","text":"俺老孙先说一句：这条路，谁也别想半道把谁丢下。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "SHARED-09-FULL-PILGRIMAGE-SEQUENCE",
      "chapter_id": "SHARED-09-FULL-PILGRIMAGE",
      "namespace": "SHARED",
      "start": "departure",
      "nodes": [
        {"id":"departure","type":"dialogue","speaker":"玄奘","text":"五人齐备，西天路也终于真正展开。前方还有千山万水，但这一次，我们一起走。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUK-01-SEQUENCE",
      "chapter_id": "WUK-01",
      "namespace": "ORIGIN",
      "start": "birth",
      "nodes": [
        {"id":"birth","type":"dialogue","speaker":"旁白","text":"一块灵石在花果山顶裂开。石猴睁眼看见天地，也第一次感到自己不属于任何人的安排。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUK-02-SEQUENCE",
      "chapter_id": "WUK-02",
      "namespace": "ORIGIN",
      "start": "cave",
      "nodes": [
        {"id":"cave","type":"dialogue","speaker":"孙悟空","text":"水帘洞虽是猴儿们的新家，也总有人想来抢走这份安稳。那就让我自己守住它。","next":"battle"},
        {"id":"battle","type":"battle","encounter_type":"origin","encounter_id":"WUKONG_ORIGIN_WATER_CAVE","source_chapter_id":"WUK-02","source_route_id":"WUKONG_ORIGIN","next":"after_battle"},
        {"id":"after_battle","type":"dialogue","speaker":"孙悟空","text":"原来守住自由，也得有承担后果的本事。","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    },
    {
      "id": "WUK-03-SEQUENCE",
      "chapter_id": "WUK-03",
      "namespace": "ORIGIN",
      "start": "sea",
      "nodes": [
        {"id":"sea","type":"dialogue","speaker":"孙悟空","text":"花果山再好，也回答不了寿数将尽的问题。若要寻找答案，就得先踏过这片海。","next":"choice"},
        {"id":"choice","type":"choice","event_id":"WUK-03","next":"finish"},
        {"id":"finish","type":"end"}
      ]
    }
  ]
